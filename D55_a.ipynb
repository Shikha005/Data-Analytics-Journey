      "source": [
        "n = 5\n",
        "# Upper half\n",
        "for i in range(1, n + 1):\n",
        "    print(\" \" * (n - i) + \"* \" * i)\n",
        "# Lower half\n",
        "for i in range(n - 1, 0, -1):\n",
        "    print(\" \" * (n - i) + \"* \" * i)"
      ],
