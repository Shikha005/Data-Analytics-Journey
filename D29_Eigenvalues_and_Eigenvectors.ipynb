      "source": [
        "import numpy as np\n",
        "\n",
        "\n",
        "A = np.array([[4, 2],\n",
        "              [1, 3]])\n",
        "\n",
        "\n",
        "print(\"Matrix:\")\n",
        "print(A)\n",
        "\n",
        "\n",
        "# Eigen decomposition\n",
        "\n",
        "eigen_values, eigen_vectors = np.linalg.eig(A)\n",
        "\n",
        "\n",
        "print(\"\\nEigen Values:\")\n",
        "print(eigen_values)\n",
        "\n",
        "\n",
        "print(\"\\nEigen Vectors:\")\n",
        "print(eigen_vectors)"
      ],
