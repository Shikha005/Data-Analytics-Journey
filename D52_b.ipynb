      "source": [
        "num = 2\n",
        "\n",
        "while num <= 100:\n",
        "    i = 2\n",
        "    is_prime = True\n",
        "\n",
        "    while i * i <= num:\n",
        "        if num % i == 0:\n",
        "            is_prime = False\n",
        "            break\n",
        "        i += 1\n",
        "\n",
        "    if is_prime:\n",
        "        print(num, end=\" \")\n",
        "\n",
        "    num += 1"
      ],
