      "source": [
        "def find_gcd(a, b):\n",
        "    gcd = 1\n",
        "    for i in range(1, min(a, b) + 1):\n",
        "        if a % i == 0 and b % i == 0:\n",
        "            gcd = i\n",
        "    return gcd\n",
        "\n",
        "print(find_gcd(48, 18))"
      ],
