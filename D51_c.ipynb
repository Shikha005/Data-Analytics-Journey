        "text = \"data analytics journey\"\n",
        "char_count = {}\n",
        "\n",
        "for ch in text:\n",
        "    if ch != \" \":\n",
        "        char_count[ch] = char_count.get(ch, 0) + 1\n",
        "\n",
        "for ch, count in char_count.items():\n",
        "    print(f\"{ch}: {count}\")"
      ],
