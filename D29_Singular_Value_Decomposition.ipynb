      "source": [
        "import numpy as np\n",
        "\n",
        "\n",
        "A = np.array([[1,2],\n",
        "              [3,4],\n",
        "              [5,6]])\n",
        "\n",
        "\n",
        "print(\"Original Matrix:\")\n",
        "print(A)\n",
        "\n",
        "\n",
        "# SVD\n",
        "\n",
        "U, S, VT = np.linalg.svd(A)\n",
        "\n",
        "\n",
        "print(\"\\nMatrix U:\")\n",
        "print(U)\n",
        "\n",
        "\n",
        "print(\"\\nSingular Values:\")\n",
        "print(S)\n",
        "\n",
        "\n",
        "print(\"\\nMatrix VT:\")\n",
        "print(VT)"
      ],
