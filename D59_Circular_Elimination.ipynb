      "source": [
        "def josephus(n, k):\n",
        "    people = list(range(1, n + 1))\n",
        "    index = 0\n",
        "\n",
        "    while len(people) > 1:\n",
        "        index = (index + k - 1) % len(people)\n",
        "        people.pop(index)\n",
        "\n",
        "    return people[0]\n",
        "\n",
        "print(josephus(7, 3))"
      ],
