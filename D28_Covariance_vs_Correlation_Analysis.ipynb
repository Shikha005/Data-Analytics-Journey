        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "df = pd.DataFrame({\n",
        "    \"Hours_Studied\":[2,4,6,8,10],\n",
        "    \"Marks\":[45,60,70,85,95]\n",
        "})\n",
        "\n",
        "print(\"Covariance Matrix\")\n",
        "print(df.cov())\n",
        "\n",
        "print(\"\\nCorrelation Matrix\")\n",
        "print(df.corr())"
